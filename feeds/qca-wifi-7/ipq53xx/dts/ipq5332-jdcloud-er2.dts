// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * IPQ5332 JDCloud Taiyi ER2 (RE-CS-08) board device tree source
 *
 * Hardware description, taken from the vendor 5.4.213 device tree
 * (official_linu_5.4.213_mi01_6.dts) and the mainline RE-CS-08 DTS:
 *
 *  - IPQ5332, DDR4 (the size is filled in by the bootloader, do not hardcode)
 *  - 1x 10G SFP+   : internal PPE port 2 / UNIPHY1, C45 PHY at MDIO addr 30,
 *                    RX_LOS = GPIO45, TX_DISABLE = GPIO34
 *  - 4x 2.5G RJ45  : QCA8386 external switch (MDIO addr 0x10), its CPU port is
 *                    wired to internal PPE port 1 / UNIPHY0 in SGMII+ mode and
 *                    the switch link interrupt is GPIO23
 *  - 64G eMMC      : SDHC controller (4 bit, HS200/DDR), GPT partitioned, the
 *                    MAC address is stored in the "factory" GPT partition
 *  - M.2 slot      : PCIe1 x2 (PERST = GPIO47)
 *  - front panel   : red = GPIO24, green = GPIO33, blue = GPIO49, SFP = GPIO36
 *  - buttons       : joy = GPIO31, reset = GPIO32
 *  - no WiFi, no USB
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "ipq5332.dtsi"
#ifdef __IPQ_MEM_PROFILE_512_MB__
#include "ipq5332-512MB-memory.dtsi"
#elif !defined(__IPQ_MEM_PROFILE_256_MB__)
#include "ipq5332-default-memory.dtsi"
#endif

/ {
	model = "JDCloud ER2 (RE-CS-08)";
	compatible = "jdcloud,er2", "jdcloud,re-cs-08", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		ethernet0 = &dp1;	/* 10G SFP+ : internal PPE port 2 */
		ethernet1 = &gmac2;	/* QCA8386 CPU port : internal PPE port 1 */
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * The console is already provided by the bootloader:
		 * bootargs=console=ttyMSM0,115200n8 earlycon clk_ignore_unused
		 * so only append what QSDK expects; a second console= here would
		 * be duplicated in /proc/cmdline (and silently ignored by the
		 * kernel).  clk_ignore_unused must stay: it keeps the bootloader /
		 * NSS owned, deviceless clocks running.
		 */
		bootargs-append = " clk_ignore_unused";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_red: led-red {
			label = "led_red";
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_green: led-green {
			label = "led_green";
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_blue: led-blue {
			label = "led_blue";
			gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		/* SFP+ cage indicator, used as a netdev LED by /etc/board.d/01_leds */
		led_sfp: led-sfp {
			label = "led_sfp";
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-joy {
			label = "joy";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};

		button-reset {
			label = "reset";
			gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@49c00000 {
			compatible = "ramoops";
			reg = <0x0 0x49c00000 0x0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			pmsg-size = <0x20000>;
		};
	};
};

/*
 * Ethernet MACs.  dp1 is the 10G SFP+ port (PPE port 2), dp2 is the CPU port
 * of the external QCA8386 switch (PPE port 1).  dp1 is described first so that
 * it becomes eth0 and dp2 becomes eth1, matching /etc/board.d/02_network.
 */
&soc {
	dp1: dp1 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <2>;
		reg = <0x3a504000 0x4000>;
		qcom,mactype = <1>;
		local-mac-address = [000000000000];
		mdio-bus = <&mdio>;
		qcom,phy-mdio-addr = <30>;
		qcom,link-poll = <1>;
		phy-mode = "sgmii";
	};

	gmac2: dp2 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <1>;
		reg = <0x3a500000 0x4000>;
		qcom,mactype = <1>;
		local-mac-address = [000000000000];
		phy-mode = "sgmii";
		qcom,mht-dev = <1>;
		qcom,is_switch_connected = <1>;
		/*
		 * Deliberate deviation from the vendor DTS, which enables
		 * "qcom,ppe-offload-disabled = <1>" on this port.
		 *
		 * nss-dp reads the property (nss_dp_main.c, of_property_read_bool)
		 * and feeds it to ppe_drv_dp_set_ppe_offload_enable_flag(iface,
		 * disable), where a set flag means "do not enable offload": PPE
		 * then keeps PPE_DRV_PORT_FLAG_OFFLOAD_ENABLED clear on PPE port 1
		 * and leaves bit 0 clear in /proc/sys/ppe/ppe_drv/if_bm_to_offload
		 * (mask 0x2 instead of 0x3).  PPE rejects every flow that touches
		 * that port - ppe_drv_port_check_flow_offload_enabled() walks a
		 * VLAN device up to its base device and requires the flag there -
		 * so eth1.x, and any bridge sitting on top of it, would never be
		 * hardware accelerated and the vendor used SFE for LAN<->WAN
		 * instead.
		 *
		 * Keeping it disabled is what the kmod-qca-nss-ppe-vlan-mgr and
		 * kmod-qca-nss-ppe-bridge-mgr clients need in order to register
		 * eth1.x / br-lan as PPE interfaces.  Uncomment only to reproduce
		 * vendor behaviour, or to take the QCA8386 CPU port out of the
		 * offload path while debugging PPE.
		 */
		/* qcom,ppe-offload-disabled = <1>; */
	};

	/* EDMA host driver configuration for this board */
	edma@3ab00000 {
		qcom,txdesc-ring-start = <4>;		/* Tx desc ring start ID */
		qcom,txdesc-rings = <12>;		/* Total number of Tx desc rings to be provisioned */
		/*
		 * The MHT rings (mht-txdesc-rings/mht-txcmpl-rings above and the
		 * MHT entries of txdesc-map below) are inherited from the vendor
		 * DTS.  nss-dp only uses them when the MHT device flag is on:
		 * qcom,mht-dev = <1> on dp2 plus nss_dp_mht_multi_txring=1 for
		 * qca-nss-dp.
		 *
		 * Measured 2026-09 on -CS-08: switching nss_dp_mht_multi_txring
		 * to 1 took the device off the network, the LAN ports stopped
		 * passing traffic and the change had to be rolled back.  The
		 * module parameter therefore stays at its default 0 (dp2 keeps the
		 * single SW port Tx ring map) and PPE offload works without it.
		 * Re-validate on the bench before ever enabling it.
		 */
		qcom,mht-txdesc-rings = <8>;		/* Extra Tx desc rings to be provisioned for MHT SW ports */
		qcom,txcmpl-ring-start = <4>;		/* Tx complete ring start ID */
		qcom,txcmpl-rings = <12>;		/* Total number of Tx complete rings to be provisioned */
		qcom,mht-txcmpl-rings = <8>;		/* Extra Tx complete rings to be provisioned for mht sw ports. */
		qcom,rxfill-ring-start = <4>;		/* Rx fill ring start ID */
		qcom,rxfill-rings = <4>;		/* Total number of Rx fill rings to be provisioned */
		qcom,rxdesc-ring-start = <12>;		/* Rx desc ring start ID */
		qcom,rxdesc-rings = <4>;		/* Total number of Rx desc rings to be provisioned */
		qcom,rx-page-mode = <0>;		/* Rx fill ring page mode */
		qcom,tx-map-priority-level = <1>;	/* Tx priority level per port */
		qcom,rx-map-priority-level = <1>;	/* Rx priority level per core */
		qcom,ppeds-num = <2>;			/* Number of PPEDS nodes */
		/* PPE-DS node format: <Rx-fill Tx-cmpl Rx Tx Queue-base Queue-count> */
		qcom,ppeds-map = <1 1 1 1 32 8>,	/* PPEDS Node#0 ring and queue map */
				<2 2 2 2 40 8>;		/* PPEDS Node#1 ring and queue map */
		qcom,txdesc-map = <8 9 10 11>,		/* Port0 per-core Tx ring map */
				<12 13 14 15>,		/* MHT-Port1 per-core Tx ring map */
				<4 5 6 7>,		/* MHT-Port2 per-core Tx ring map/packets from vp */
				<16 17 18 19>,		/* MHT-Port3 per-core Tx ring map */
				<20 21 22 23>;		/* MHT-Port4 per-core Tx ring map */
		qcom,txdesc-fc-grp-map = <1 2 3 4 5>;	/* Per GMAC flow control group map */
		qcom,rxfill-map = <4 5 6 7>;		/* Per-core Rx fill ring map */
		qcom,rxdesc-map = <12 13 14 15>;	/* Per-core Rx desc ring map */
		/*
		 * No VP ring is provisioned on this board, which is a deliberate
		 * deviation from the vendor DTS (ipq5332-rdp441.dts declares
		 * qcom,rxdesc-vp-ring-idx = <4> and qcom,rx-vp-rings = <1>):
		 *  - NSS_DP_VP_RINGS is not defined in this build, so
		 *    NSS_DP_VP_NUM_RINGS is 0 and a DT entry would have hit
		 *    BUG_ON(rx_vp_rings > NSS_DP_VP_NUM_RINGS) in
		 *    edma_of_get_vp_pdata();
		 *  - ring index 4 only exists in the vendor MINENT profile (5 Rx
		 *    desc rings with 5-entry rxdesc-map/rx-ring-queue-map).  With
		 *    the 4 rings used here (12..15, map <12 13 14 15>), the VP
		 *    queue map would read past the end of those maps and remap
		 *    PPE queues 0..7 onto an unallocated ring.
		 * PPE virtual port Rx (ppe_vp_rx_dp_cb, registered by
		 * qca-nss-ppe-vp) therefore stays unavailable; enable it only
		 * together with a 5th Rx desc ring, matching maps and an nss-dp
		 * rebuilt with NSS_DP_VP_RINGS defined.
		 */
		qcom,rx-queue-start = <0>;		/* Rx queue start */
		qcom,rx-ring-queue-map = <0 8 16 24>,	/* Priority 0 queues per-core Rx ring map */
					  <1 9 17 25>,	/* Priority 1 queues per-core Rx ring map */
					  <2 10 18 26>,	/* Priority 2 queues per-core Rx ring map */
					  <3 11 19 27>,	/* Priority 3 queues per-core Rx ring map */
					  <4 12 20 28>,	/* Priority 4 queues per-core Rx ring map */
					  <5 13 21 29>,	/* Priority 5 queues per-core Rx ring map */
					  <6 14 22 30>,	/* Priority 6 queues per-core Rx ring map */
					  <7 15 23 31>;	/* Priority 7 queues per-core Rx ring map */
		interrupts = <0 163 4>,			/* Tx complete ring id #4 IRQ info */
			   <0 164 4>,			/* Tx complete ring id #5 IRQ info */
			   <0 165 4>,			/* Tx complete ring id #6 IRQ info */
			   <0 166 4>,			/* Tx complete ring id #7 IRQ info */
			   <0 167 4>,			/* Tx complete ring id #8 IRQ info */
			   <0 168 4>,			/* Tx complete ring id #9 IRQ info */
			   <0 169 4>,			/* Tx complete ring id #10 IRQ info */
			   <0 170 4>,			/* Tx complete ring id #11 IRQ info */
			   <0 171 4>,			/* Tx complete ring id #12 IRQ info */
			   <0 172 4>,			/* Tx complete ring id #13 IRQ info */
			   <0 173 4>,			/* Tx complete ring id #14 IRQ info */
			   <0 174 4>,			/* Tx complete ring id #15 IRQ info */
			   <0 139 4>,			/* Rx desc ring id #12 IRQ info */
			   <0 140 4>,			/* Rx desc ring id #13 IRQ info */
			   <0 141 4>,			/* Rx desc ring id #14 IRQ info */
			   <0 142 4>,			/* Rx desc ring id #15 IRQ info */
			   <0 191 4>,			/* Misc error IRQ info */
			   <0 160 4>,			/* PPEDS Node #1(TxComp ring id #1) TxComplete IRQ info */
			   <0 128 4>,			/* PPEDS Node #1(Rx Desc ring id #1) Rx Desc IRQ info */
			   <0 152 4>,			/* PPEDS Node #1(RxFill Desc ring id #1) Rx Fill IRQ info */
			   <0 161 4>,			/* PPEDS Node #2(TxComp ring id #2) TxComplete IRQ info */
			   <0 129 4>,			/* PPEDS Node #2(Rx Desc ring id #2) Rx Desc IRQ info */
			   <0 153 4>,			/* PPEDS Node #2(RxFill Desc ring id #2) Rx Fill IRQ info */
			   <0 175 4>,			/* MHT port Tx complete ring id #16 IRQ info */
			   <0 176 4>,			/* MHT port Tx complete ring id #17 IRQ info */
			   <0 177 4>,			/* MHT port Tx complete ring id #18 IRQ info */
			   <0 178 4>,			/* MHT port Tx complete ring id #19 IRQ info */
			   <0 179 4>,			/* MHT port Tx complete ring id #20 IRQ info */
			   <0 180 4>,			/* MHT port Tx complete ring id #21 IRQ info */
			   <0 181 4>,			/* MHT port Tx complete ring id #22 IRQ info */
			   <0 182 4>;			/* MHT port Tx complete ring id #23 IRQ info */
	};
};


/*
 * MDIO bus: the four embedded PHYs of the QCA8386 switch are marked with the
 * ssdk "fixup" property, GPIO51 is the shared PHY/switch reset line.
 */
&mdio {
	pinctrl-0 = <&mdio1_pins &mdio0_pins>;
	pinctrl-names = "default";
	phy-reset-gpio = <&tlmm 51 GPIO_ACTIVE_LOW>;
	phyaddr_fixup = <0xC90F018>;
	uniphyaddr_fixup = <0xC90F014>;
	mdio_clk_fixup;		/* MDIO clock sequence fix up flag */
	status = "okay";

	phy0: ethernet-phy@0 {
		reg = <1>;
		fixup;
	};

	phy1: ethernet-phy@1 {
		reg = <2>;
		fixup;
	};

	phy2: ethernet-phy@2 {
		reg = <3>;
		fixup;
	};

	phy3: ethernet-phy@3 {
		reg = <4>;
		fixup;
	};

	/*
	 * The external QCA8386 switch.  It is driven by the QSDK ssdk
	 * "switch1" node below, so the mainline qca8k DSA description is kept
	 * disabled here.  Enable it (and disable the ssdk switch1 node) when
	 * running with the kmod-qca8k DSA driver instead.
	 */
	switch0@10 {
		compatible = "qca,qca8386";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "cpu";
				ethernet = <&gmac2>;
				phy-mode = "sgmii";
			};

			port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&phy0>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&phy1>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&phy2>;
			};

			port@4 {
				reg = <4>;
				label = "lan4";
				phy-handle = <&phy3>;
			};
		};
	};
};


/*
 * Internal PPE switch (UNIPHY0 -> QCA8386 uplink, UNIPHY1 -> 10G SFP+) and the
 * external QCA8386 front panel switch ("switch1").
 */
&ess_instance {
	num_devices = <2>;

	ess-switch@3a000000 {
		pinctrl-0 = <&sfp_pins>;
		pinctrl-names = "default";

		switch_cpu_bmp = <0x1>;		/* cpu port bitmap */
		switch_lan_bmp = <0x2>;		/* lan port bitmap (PPE port 1) */
		switch_wan_bmp = <0x4>;		/* wan port bitmap (PPE port 2) */
		switch_mac_mode = <0xc>;	/* mac mode for uniphy instance0 (SGMII+) */
		switch_mac_mode1 = <0xe>;	/* mac mode for uniphy instance1 (10GBASE-R) */
		switch_mac_mode2 = <0xff>;	/* mac mode for uniphy instance2 */

		qcom,port_phyinfo {
			port@0 {
				port_id = <1>;
				forced-speed = <2500>;
				forced-duplex = <1>;

				switch_external {
					switch_handle = <&switch1>;
					switch_cpu_port = <0>;
				};
			};

			port@1 {
				port_id = <2>;
				phy_address = <30>;
				media-type = "sfp";	/* fiber mode */
			};
		};

		led_source@5 {
			source = <5>;
			mode = "normal";
			speed = "all";
			blink_en = "enable";
			active = "high";
		};
	};

	switch1: ess-switch1@1 {
		compatible = "qcom,ess-switch-qca8386";
		device_id = <1>;
		switch_access_mode = "mdio";
		mdio-bus = <&mdio>;
		switch_mac_mode = <0xc>;	/* mac mode for uniphy instance0 */
		switch_mac_mode1 = <0xff>;	/* mac mode1 for uniphy instance1 */
		switch_cpu_bmp = <0x1>;		/* Port0 is the CPU port */
		switch_lan_bmp = <0x1e>;	/* Port1-Port4 are front panel ports */
		switch_wan_bmp = <0x0>;
		link-polling-required = <0>;
		fdb_sync = "interrupt";
		link-intr-gpio = <&tlmm 23 GPIO_ACTIVE_HIGH>;

		qcom,port_phyinfo {
			port@0 {
				port_id = <0>;
				forced-speed = <2500>;
				forced-duplex = <1>;
			};
			port@1 {
				port_id = <1>;
				phy_address = <1>;
			};
			port@2 {
				port_id = <2>;
				phy_address = <2>;
			};
			port@3 {
				port_id = <3>;
				phy_address = <3>;
			};
			port@4 {
				port_id = <4>;
				phy_address = <4>;
			};
		};

		led_source@2 {
			source = <2>;
			mode = "normal";
			speed = "all";
			blink_en = "enable";
			active = "high";
		};

		led_source@5 {
			source = <5>;
			mode = "normal";
			speed = "all";
			blink_en = "enable";
			active = "high";
		};

		led_source@8 {
			source = <8>;
			mode = "normal";
			speed = "all";
			blink_en = "enable";
			active = "high";
		};
	};
};


/* PINCTRL */
&tlmm {
	led_pins: led-state {
		pins = "gpio24", "gpio33", "gpio36", "gpio49";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: button-state {
		pins = "gpio31", "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	i2c1_pins: i2c1-state {
		pins = "gpio29", "gpio30";
		function = "blsp1_i2c0";
		drive-strength = <8>;
		bias-pull-up;
	};

	sfp_pins: sfp-state {
		sfp_rx_los {
			pins = "gpio45";
			function = "rx1";
			bias-disable;
		};

		sfp_tx_disable {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio13";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio12";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_default_state: pcie1-default-state {
		clkreq-n-pins {
			pins = "gpio46";
			function = "pcie1_clk";
			drive-strength = <8>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio47";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio48";
			function = "pcie1_wake";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

/* Console */
&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* SFP+ EEPROM / module I2C bus */
&blsp1_i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

/* eMMC (64G, GPT partitioned) */
&sdhc {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";
};

/* M.2 slot: 2 lane PCIe1, PERST on GPIO47 */
&pcie1_phy_x2 {
	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&pcie1_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	status = "okay";
};

/* The other two PCIe controllers are not wired up on this board */
&pcie0 {
	status = "disabled";
};

&pcie2 {
	status = "disabled";
};

/* No USB on this board */
&usb3 {
	status = "disabled";
};

/*
 * WiFi / WCSS / MLO reserved memory is not used on this board.
 *
 * Every region below is a "no-map" carve-out that the QSDK default memory
 * profile reserves for the Q6 (WCSS) firmware, for its dump buffers, for the
 * calibration database, for the MLO global buffer and for the Q6 host DDR
 * buffer.  Marking the nodes "disabled" makes the kernel skip them in the
 * reserved-memory scan (same mechanism that ipq5332-default-memory.dtsi
 * already uses for qcn9224_pcie0/1 + dma_pool0/1, which is why those never
 * show up in the boot log), which:
 *
 *   - returns ~60 MB to Linux:
 *       wcnss@4a900000            35 MB
 *       q6_ipq5332_data@4b500000  23 MB  (fully contained in wcnss, so no
 *                                         extra gain - it is the region that
 *                                         triggers the overlap warning)
 *       m3_dump@4cc00000           1 MB
 *       q6_etr_dump@1              1 MB
 *       q6_caldb_region@4ce00000   5 MB
 *       mlo_global_mem_0@4db00000 18 MB
 *   - removes the vendor profile bug
 *       "OF: reserved mem: OVERLAP DETECTED! wcnss@4a900000 ... overlaps with
 *        q6_ipq5332_data@4b500000"
 *       (q6_ipq5332_data@4b500000 is fully contained in wcnss@4a900000)
 *
 * Unrelated noise that is *not* addressed here: the boot warning
 * "Minidump: rsvd region is not specified" comes from
 * drivers/soc/qcom/ctx-save.c, which asks for the minidump region through the
 * "memory-region" phandle of the qti,ctxt-save-ipq5332 node.  That phandle
 * points at minidump_mem@0, a node the vendor dtsi describes without a "reg"
 * property, so of_reserved_mem_lookup() returns NULL.  Disabling the regions
 * below does not change that message.
 *
 * The regions that the bootloader / TZ / SMEM really use (tzapp, bootloader,
 * sbl, tz, smem, ramoops) are deliberately left enabled.  Re-enable the
 * regions below if the M.2 QCN9224 WiFi module is ever brought up over
 * PCIe-MHI together with the WCSS remoteproc.
 */
/ {
	reserved-memory {
		wcnss@4a900000 {
			status = "disabled";
		};

		q6_ipq5332_data@4b500000 {
			status = "disabled";
		};

		m3_dump@4cc00000 {
			status = "disabled";
		};

		q6_etr_dump@1 {
			status = "disabled";
		};

		q6_caldb_region@4ce00000 {
			status = "disabled";
		};

		mlo_global_mem_0@0x4db00000 {
			status = "disabled";
		};
	};
};

/*
 * No WiFi on this board: keep the WCSS remoteproc and every WiFi node off so
 * that the Q6 firmware is never loaded and the wireless reserved memory is not
 * used by any driver.
 */
&q6v5_wcss {
	status = "disabled";
};

&wifi0 {
	status = "disabled";
};

&wifi1 {
	status = "disabled";
};

&wifi2 {
	status = "disabled";
};

&wifi3 {
	status = "disabled";
};

&wifi4 {
	status = "disabled";
};

&wifi5 {
	status = "disabled";
};

/*
 * License manager.  ipq5332.dtsi ships this node "disabled"; the vendor RDP
 * boards turn it on to hand license blobs to an attached PCIe device, or to
 * the WCSS/Q6 remoteproc through lm_get_license().  This board has neither:
 * the only PCIe device is the internal Qualcomm bridge (0001:00:00.0, class
 * 0x060400, no driver), all &wifi nodes stay disabled, and the node carries
 * no license-feature/tmel-bounded property - so the driver only adds
 * "lm license_manager: License Manager registered successfully" plus a
 * /sys/kernel/license_manager/* that nothing reads.  Keep it off; re-enable
 * (with the matching properties) if a licensed PCIe endpoint is attached one
 * day.
 */
&license_manager {
	status = "disabled";
};

/* ================================================================== */
/*                     MISC BOARD FIXUPS                              */
/* ================================================================== */

/*
 * L2 cache: the IPQ5332 has one unified L2 shared by the four A53 cores.
 * ipq5332.dtsi describes it as "compatible = cache; cache-level = <2>" and
 * points every CPU at it through next-level-cache, but it is missing the
 * "cache-unified" flag that the mainline ipq5332.dtsi carries.  Without it the
 * cacheinfo core cannot classify the L2 leaf and the boot log shows
 * "cacheinfo: Unable to detect cache hierarchy for CPU 0"
 * (drivers/base/cacheinfo.c, pr_warn in detect_cache_attributes()).
 */
&L2_0 {
	cache-unified;
};

/*
 * Context save / minidump.  The vendor ipq5332.dtsi wires ctx-save to
 * minidump_mem@0, a node that carries no "reg" property (it is only a label
 * for a region the bootloader was supposed to fill in).  of_reserved_mem_lookup()
 * can therefore never resolve it, so ctx-save.c prints
 * "Minidump: rsvd region is not specified" and never schedules its dump worker.
 * Dropping the phandle makes the driver take the "no memory-region" path
 * instead of the "unresolvable memory-region" path - same behaviour, no noise.
 * Restore the phandle (and give minidump_mem@0 a real reg) if crash dumps are
 * needed later on.
 */
&ctx_save {
	/delete-property/ memory-region;
};

/* ================================================================== */
/*                     CLOCK FREQUENCIES                              */
/* ================================================================== */
&sleep_clk {
    clock-frequency = <32000>;
};

&xo {
    clock-frequency = <24000000>;
};

/* 如果还有其他缺失的时钟频率 */
&pcie_2lane_phy_pipe_clk {
    clock-frequency = <250000000>;
};

&pcie_2lane_phy_pipe_clk_x1 {
    clock-frequency = <250000000>;
};

&usb_pcie_wrapper_pipe_clk {
    clock-frequency = <250000000>;
};