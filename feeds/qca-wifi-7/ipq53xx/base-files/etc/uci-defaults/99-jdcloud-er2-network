#!/bin/sh
# JDCloud ER2 (RE-CS-08): create the default LAN/WAN configuration.
#
# patches-25.12/0021-base-files-do-not-generate-default-interfaces-on-fir.patch
# comments out the generate_network() loop in /bin/config_generate, so the
# network section that this target's /etc/board.d/02_network writes ends up in
# /etc/board.json only and is never turned into /etc/config/network. Recreate
# the defaults generate_network() would have emitted for this board:
#
#	lan	br-lan (eth0 + switch VLAN 2 CPU port eth1.2), 192.168.1.1/24
#	wan	eth1.1 (switch VLAN 1, port 1), DHCP client
#	device	the factory MAC addresses of network_device (board.json)
#
# Only fill in what is not configured yet, so that the settings of an existing
# installation survive a keep-config sysupgrade.

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	jdcloud,er2|jdcloud,re-cs-08) ;;
	*) exit 0 ;;
esac

# config_generate created /etc/config/network right before this script runs.
# uci refuses to create a section in a config file that does not exist.
[ -f /etc/config/network ] || touch /etc/config/network

changed=0

# This board gets its MAC addresses from the factory partition; board.d/02_network
# puts them into /etc/board.json as network_device. netifd applies them itself for
# devices whose name matches the key exactly (eth0, eth1), but the switch CPU port
# VLANs are stored as eth1_1/eth1_2, so eth1.1/eth1.2 would keep the address the
# driver picked - unless a "config device" section says otherwise, which is what
# the replaced generate_network() loop used to emit. Never touch a device that is
# configured already.
add_device_mac() {
	local key="$1" macaddr="$2" device

	[ -n "$key" ] && [ -n "$macaddr" ] || return 0

	# board.json stores eth1.1 as eth1_1; netifd knows the device as eth1.1
	device="$(echo "$key" | sed 's/_\([0-9][0-9]*\)$/.\1/')"
	[ -z "$(uci -q get "network.$key")" ] || return 0

	uci -q set "network.$key=device"
	uci -q set "network.$key.name=$device"
	uci -q set "network.$key.macaddr=$macaddr"

	changed=1
}

if [ -z "$(uci -q get network.lan)" ]; then
	uci -q delete network.brlan
	uci -q set network.brlan='device'
	uci -q set network.brlan.name='br-lan'
	uci -q set network.brlan.type='bridge'
	uci -q add_list network.brlan.ports='eth0'
	uci -q add_list network.brlan.ports='eth1.2'

	uci -q set network.lan='interface'
	uci -q set network.lan.device='br-lan'
	uci -q set network.lan.proto='static'
	uci -q add_list network.lan.ipaddr='192.168.1.1/24'
	uci -q set network.lan.ip6assign='60'

	changed=1
fi

if [ -z "$(uci -q get network.wan)" ]; then
	uci -q set network.wan='interface'
	uci -q set network.wan.device='eth1.1'
	uci -q set network.wan.proto='dhcp'

	if [ -e /proc/sys/net/ipv6 ]; then
		uci -q delete network.wan6
		uci -q set network.wan6='interface'
		uci -q set network.wan6.device='eth1.1'
		uci -q set network.wan6.proto='dhcpv6'
	fi

	changed=1
fi

# board.json (written by /etc/board.d/02_network) holds the factory MACs of this
# unit, including the switch CPU port VLANs as eth1_1/eth1_2. generate_network()
# used to turn them into "config device" sections; do the same here.
if [ -f /etc/board.json ] && [ -f /usr/share/libubox/jshn.sh ]; then
	. /usr/share/libubox/jshn.sh

	json_load "$(cat /etc/board.json)"
	if json_is_a network_device object; then
		json_select network_device
		json_get_keys devices
		for device in $devices; do
			json_select "$device"
			json_get_var macaddr macaddr
			json_select ..

			add_device_mac "$device" "$macaddr"
		done
		json_select ..
	fi
fi

[ "$changed" = "0" ] && exit 0

# Exit non-zero when the commit did not go through: uci_apply_defaults() only
# removes this script after a success, so the config is then retried next boot.
uci commit network || exit 1

exit 0
