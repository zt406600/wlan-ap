# r44 (d928ec333aa0cacfda7cc3fc1f199e6ad8d1027e) added
# qca8084_fill_possible_interfaces(), which writes the mode mask the PHY could
# use into phydev->possible_interfaces.  That member only exists from Linux 6.9
# onwards; on 6.6 the closest member, phydev->host_interfaces, is filled by the
# host (phylink intersects it with the SFP interface modes, marvell10g.c reads
# it to select the MAC type), so it cannot serve as an output mask here.  Keep
# the helper a no-op below 6.9, i.e. the behaviour of the r41 sources it
# replaces.
diff --git a/linux_std/qca8084/qca8084.c b/linux_std/qca8084/qca8084.c
index ca5b4c5..6113d0f 100644
--- a/linux_std/qca8084/qca8084.c
+++ b/linux_std/qca8084/qca8084.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/sysfs.h>
+#include <linux/version.h>
 #include "../qcom_phy_lib.h"
 #include "../clock/qca8k_clk.h"
 
@@ -589,6 +590,7 @@ static int qca8084_icc_efuse_init(struct phy_device *phydev)
 
 static void qca8084_fill_possible_interfaces(struct phy_device *phydev)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 9, 0))
 	unsigned long *possible = phydev->possible_interfaces;
 
 	if (phydev->interface == PHY_INTERFACE_MODE_QUSGMII) {
@@ -597,6 +599,16 @@ static void qca8084_fill_possible_interfaces(struct phy_device *phydev)
 		__set_bit(PHY_INTERFACE_MODE_SGMII, possible);
 		__set_bit(PHY_INTERFACE_MODE_2500BASEX, possible);
 	}
+#else
+	/*
+	 * phydev->possible_interfaces only exists from Linux 6.9 onwards.  On
+	 * 6.6 the only comparable member is phydev->host_interfaces, and that
+	 * one is filled by the host (phylink intersects it with the SFP
+	 * interface modes and marvell10g.c reads it to select the MAC type),
+	 * so it cannot be used as an output mask here.  Nothing to populate.
+	 */
+	(void)phydev;
+#endif
 }
 
 static int qca8084_config_init(struct phy_device *phydev)
