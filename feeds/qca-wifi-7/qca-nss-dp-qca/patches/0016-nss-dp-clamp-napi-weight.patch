# ---
# nss-dp: clamp the NAPI weight handed to the kernel to NAPI_POLL_WEIGHT
#
# The EDMA HAL budgets (ipq53xx: Rx 128, TxCmpl 256, RxFill 512) and the PPE-DS
# budgets handed over by ppe_ds are larger than the kernel NAPI_POLL_WEIGHT (64).
# netif_napi_add_weight() therefore reports "netif_napi_add_weight() called with
# weight %d" once per device during probe, and such a weight also allows a single
# NAPI instance to drain the whole net_rx_action() budget.
#
# Cap the weight with edma_napi_weight() at every netif_napi_add_weight() call
# site of the EDMA v2 HAL.  The budgets stay configurable for any value up to
# the limit through nss_dp_rx_napi_budget/nss_dp_rxfill_napi_budget/
# nss_dp_tx_napi_budget.
# ---
--- a/hal/dp_ops/edma_dp/edma_v2/edma.h
+++ b/hal/dp_ops/edma_dp/edma_v2/edma.h
@@ -40,6 +40,25 @@
 #error "Build Error: Platform is enabled with IOMMU/SMMU support."
 #endif
 
+/*
+ * edma_napi_weight()
+ *	Clamp a HAL NAPI budget to the maximum weight the kernel accepts.
+ *
+ * The HAL budgets (nss_dp_rx_napi_budget, nss_dp_rxfill_napi_budget,
+ * nss_dp_tx_napi_budget) and the budgets handed over by ppe_ds
+ * (eth_txcomp_budget, eth_rxfill_budget) are tuned for throughput and can be
+ * larger than NAPI_POLL_WEIGHT.  netif_napi_add_weight() does not accept such
+ * a weight, it reports "netif_napi_add_weight() called with weight %d" once per
+ * device, and a weight above NAPI_POLL_WEIGHT also lets a single NAPI instance
+ * drain the whole net_rx_action() budget, which the softirq fairness model does
+ * not expect.  Cap the value handed to the kernel and keep the budgets usable
+ * for anything up to the limit.
+ */
+static inline int edma_napi_weight(int budget)
+{
+	return (budget > NAPI_POLL_WEIGHT) ? NAPI_POLL_WEIGHT : budget;
+}
+
 #define EDMA_HW_RESET_ID		"edma_rst"
 #define EDMA_CFG_RESET_ID		"edma_cfg_rst"
 #define EDMA_DEVICE_NODE_NAME		"edma"
--- a/hal/dp_ops/edma_dp/edma_v2/edma_cfg_rx.c
+++ b/hal/dp_ops/edma_dp/edma_v2/edma_cfg_rx.c
@@ -1819,7 +1819,7 @@
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0))
 		netif_napi_add(netdev, &rxdesc_ring->napi, napi_poll, nss_dp_rx_napi_budget);
 #else
-		netif_napi_add_weight(netdev, &rxdesc_ring->napi, napi_poll, nss_dp_rx_napi_budget);
+		netif_napi_add_weight(netdev, &rxdesc_ring->napi, napi_poll, edma_napi_weight(nss_dp_rx_napi_budget));
 #endif
 		rxdesc_ring->napi_added = true;
 	}
@@ -1840,7 +1840,7 @@
 			edma_rxfill_napi_poll, nss_dp_rxfill_napi_budget);
 #else
 		netif_napi_add_weight(netdev, &rxfill_ring->napi,
-			edma_rxfill_napi_poll, nss_dp_rxfill_napi_budget);
+			edma_rxfill_napi_poll, edma_napi_weight(nss_dp_rxfill_napi_budget));
 #endif
 		rxfill_ring->napi_added = true;
 	}
