# ---
# nss-dp: do not stop/start the PHY on every ifdown/ifup
#
# phy_stop() in nss_dp_close() and a plain phy_start() in nss_dp_open() make the
# PHY go through a full link renegotiation on every administrative down/up, and
# on these boards the PHY is shared with the switch/PPE path: the link flaps
# while the PPE still holds the port state.  Keep the PHY running on close and
# only retrigger the state machine when it is already started, and stop it once
# during remove before disconnecting it.
# ---
--- a/nss_dp_main.c
+++ b/nss_dp_main.c
@@ -500,8 +500,6 @@
 #endif
 	{
 		netif_carrier_off(netdev);
-		if (dp_priv->phydev)
-			phy_stop(dp_priv->phydev);
 	}
 	dp_priv->link_state = __NSS_DP_LINK_DOWN;
 
@@ -646,7 +644,12 @@
 		netif_carrier_on(netdev);
 	} else {
 		dp_priv->link_state = __NSS_DP_LINK_DOWN;
-		phy_start(dp_priv->phydev);
+		if (phy_is_started(dp_priv->phydev)) {
+			dp_priv->phydev->state = PHY_UP;
+			phy_trigger_machine(dp_priv->phydev);
+		} else {
+			phy_start(dp_priv->phydev);
+		}
 		phy_start_aneg(dp_priv->phydev);
 	}
 
@@ -1357,6 +1360,8 @@
 #endif
 		{
 			if (dp_priv->phydev) {
+				if (phy_is_started(dp_priv->phydev))
+					phy_stop(dp_priv->phydev);
 				phy_disconnect(dp_priv->phydev);
 				dp_priv->phydev = NULL;
 			}
