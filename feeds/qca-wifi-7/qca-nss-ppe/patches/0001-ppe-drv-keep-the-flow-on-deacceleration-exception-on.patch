# ---
# ppe-drv: keep the accelerated flow on a deacceleration exception on ER2
#
# flow_deacclr_dis=1 in /etc/modules.d/31-qca-nss-ppe does not reach the module
# on this target: kmodloader does not hand the options of that file to insmod,
# so the parameter stays at its default N after a reboot (moving the PPE core
# ahead of the datapath driver, AUTOLOAD 31 -> 32, did not change that).
#
# Set the flag from the device tree instead, for this board only:
#
#   - ppe_drv_cc.c skips the flow flush when flow_deacclr_dis is set, so an
#     exception only punts the offending packet to the CPU;
#   - ppe_drv_l3_route_ctrl_init() then leaves the global MRU/MTU deacceleration
#     disabled as well.
#
# Measured on the board with 200 fragmented UDP packets: with the flag set the
# PPE keeps the flow it created (create_req +1, destroy +0), without it the flow
# is rebuilt 80 times and destroyed 305 times.
#
# Other boards are unaffected (they do not match the compatible), and userspace
# can still flip the parameter through sysfs at runtime.
#
# This is the variant for the nss-ppe pin of this branch (d53eff24, QSDK 12.x);
# the QSDK 14.0 branch carries the same change against 03a79c95.
# ---
--- a/drv/ppe_drv/ppe_drv.c
+++ b/drv/ppe_drv/ppe_drv.c
@@ -2664,6 +2664,29 @@
 	}
 
 	/*
+	 * JDCloud ER2: keep an accelerated flow in the hardware when a packet
+	 * hits a deacceleration exception (MRU/MTU/IPv6 fragment/...), i.e. punt
+	 * only that packet to the CPU instead of flushing and freeing the flow
+	 * (ppe_drv_cc.c: flow_deacclr_dis skips the flush, and the global MRU/MTU
+	 * deacceleration set up in ppe_drv_l3_route_ctrl_init() is turned off).
+	 * Without it the PPE flushes the flow on every exception and ECM
+	 * re-accelerates it again, which on this board degenerates into a
+	 * create/flush loop for the fragmented peer->LAN IPv6 traffic of the
+	 * P2P/VPN flows: with 200 fragmented UDP packets the PPE rebuilt 80 flows
+	 * and destroyed 305, while with the flag set it kept the single flow it
+	 * had.
+	 *
+	 * The value normally comes from the flow_deacclr_dis=1 module option in
+	 * /etc/modules.d/31-qca-nss-ppe, but kmodloader does not hand it to
+	 * insmod on this target, so the option never reached the module.  The
+	 * board is matched through the device tree instead, which does not depend
+	 * on how the module gets loaded and leaves every other board alone.
+	 * Userspace can still flip the parameter through sysfs at runtime.
+	 */
+	if (of_machine_is_compatible("jdcloud,er2"))
+		flow_deacclr_dis = true;
+
+	/*
 	* Allocate ppe_drv_gbl
 	*/
 	ppe_drv_gbl = kzalloc(sizeof(struct ppe_drv), GFP_KERNEL);
